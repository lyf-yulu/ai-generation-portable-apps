APP_HOST=127.0.0.1
APP_PORT=8765
DATA_DIR=data
OUTPUTS_DIR=outputs
BUSINESS_DB_PATH=data/agent.sqlite3
CHECKPOINT_DB_PATH=data/checkpoints.sqlite3
LARK_APP_ID=
LARK_APP_SECRET=
LARK_BITABLE_URL=
LARK_BITABLE_TABLE_ID=
LARK_BITABLE_VIEW_ID=
# 多维表格模式只读取/写入既有的「文本、需求来源、执行人、结果」四列；
# 不会创建状态、错误或执行人字段。执行人仅展示，不作为扫描过滤条件。
LARK_PRODUCTION_BITABLE_URL=
LARK_PRODUCTION_TABLE_ID=
# 动画类与真人类使用同一生产表的不同视图。
LARK_PRODUCTION_VIEW_ID=
LARK_PRODUCTION_PORTRAIT_VIEW_ID=
LARK_RESULT_FOLDER_TOKEN=
LARK_INCLUDE_COMPLETED_FOR_TEST=false
# 生产表模式只读「需求名称、需求类型、需求附件、项目名称、发起人、需求制作人、当前进度」。
# 结果仅写到结果文件夹中的唯一「统一结果表」，绝不回写生产表。
# 以下两个字段仅旧版“新建飞书交付文档”模式需要；使用多维表格回写时可留空。
LARK_OUTPUT_OWNER_OPEN_ID=
LARK_OUTPUT_FOLDER_TOKEN=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
CLAUDE_API_KEY=
CLAUDE_BASE_URL=
CLAUDE_MODEL=
CHIYUN_API_KEY=
CHIYUN_BASE_URL=https://chiyun.work
CHIYUN_MODEL=
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDANCE_MODEL=doubao-seedance-2-0-260128
VOLCENGINE_ACCESS_KEY=
VOLCENGINE_SECRET_KEY=
# Seedance 参考素材先上传到公司 TOS，再把 12 小时签名 HTTPS 地址交给方舟。
# AK/SK 复用 VOLCENGINE_ACCESS_KEY / VOLCENGINE_SECRET_KEY。
TOS_BUCKET=
TOS_REGION=cn-beijing
ALLOW_BENCHMARK_FAKE_IPS=false
BOT_SCAN_PAGE_SIZE=10
COORDINATOR_POLL_INTERVAL_SECONDS=1.0
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=feishu-generation-agent-local
LANGGRAPH_STRICT_MSGPACK=true
ALLOW_PAID_SMOKE=NO

# 素材库对外 URL base。服务机 LAN IP 每周会变，部署时按实际填写；
# 改这个值后必须跑 scripts/rewrite_asset_urls.py 重写已有素材的 storage_url。
ASSET_BASE_URL=http://127.0.0.1:8765
