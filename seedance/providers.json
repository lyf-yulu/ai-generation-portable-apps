      "defaults": {
        "model": "doubao-seedance-2-0-260128",
        "duration": 12,
        "resolution": "720p",
        "ratio": "16:9",
        "repeat_count": 1,
        "concurrency": 1,
        "poll_interval": 10,
        "timeout": 3600,
        "vary_seed": true
