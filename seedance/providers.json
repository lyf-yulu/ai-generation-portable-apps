          "resolutions": ["480p", "720p", "1080p", "4k"],
          "ratios": ["21:9", "16:9", "4:3", "1:1", "3:4", "9:16", "adaptive"]
        },
        {
          "id": "doubao-seedance-2-0-fast-260128",
